      "rotation" : 0.5,
      "text" : {
        "alignment" : "leading",
        "autoHeight" : true,
        "content" : "**CHABAD-LUBAVITCH**\nA Hasidic movement founded by Shneur Zalman of Liadi in the late 18th century. Its institutional account describes religious learning, education and social services. [R02]",
        "fontSize" : 17,
        "style" : "note"
      },
      "tint" : "violet",
      "type" : "text",
      "z" : 52
    },
