      "text" : {
        "alignment" : "leading",
        "autoHeight" : true,
        "content" : "**2020 / THE DEAL REVIEWED**\nDOJ’s OPR found poor judgment by Alexander Acosta over the deal and victim notification, and criticized the treatment of victims. It did **not** find professional misconduct by DOJ attorneys. [E04]",
        "fontSize" : 17,
        "style" : "note"
      },
      "tint" : "azure",
