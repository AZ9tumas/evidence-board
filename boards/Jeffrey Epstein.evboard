      "rotation" : -0.5,
      "text" : {
        "alignment" : "leading",
        "autoHeight" : true,
        "content" : "**29 AUG 2019 / DISMISSAL**\nThe federal case was dismissed following Epstein’s death. Victims spoke at an August hearing.\nThis was not an acquittal or a finding that the allegations were false. [E03]",
        "fontSize" : 17,
        "style" : "note"
      },
      "tint" : "azure",
      "type" : "text",
      "z" : 29
    },
