    "x": -760,
    "y": 820
   },
   "id": "4CCB535A-6A52-5A04-A9AF-CA019B7C8221",
   "locked": false,
   "modifiedAt": "2026-10-15T15:00:00Z",
   "rotation": -0.4,
   "type": "web",
   "web": {
    "snapshot": {
     "description": "ATMOS howitzers, SPEAR mortars, drones; production in Albania.",
     "fetchedAt": "2026-10-15T15:00:00Z",
     "palette": {
      "darkMuted": "#141E29",
      "darkVibrant": "#0C2846",
      "light": "#E5F0FB",
      "muted": "#62809E",
      "vibrant": "#2D6FB0"
     },
     "publishedAt": "2025-11-12T00:00:00Z",
